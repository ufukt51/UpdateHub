<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Grafit: nötr koyu gri, sabit mavi vurgu. Vurgu Windows'tan alınmaz. -->
    <Color x:Key="AccentColor">#5AA2FF</Color>

    <SolidColorBrush x:Key="Bg" Color="#1B1B1E" />
    <SolidColorBrush x:Key="Surface" Color="#232327" />
    <SolidColorBrush x:Key="Raised" Color="#2D2D33" />
    <SolidColorBrush x:Key="Line" Color="#36363E" />
    <SolidColorBrush x:Key="LineSoft" Color="#2B2B31" />
    <SolidColorBrush x:Key="Text" Color="#ECECF1" />
    <SolidColorBrush x:Key="Muted" Color="#9B9BA7" />
    <SolidColorBrush x:Key="Dim" Color="#6C6C78" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="#08182D" />
    <SolidColorBrush x:Key="Sel" Color="#245AA2FF" />
    <SolidColorBrush x:Key="Hover" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Pressed" Color="#1A000000" />

    <!-- Anlamsal renkler: rozetler ve durum -->
    <Color x:Key="OkColor">#4CC38A</Color>
    <Color x:Key="WarnColor">#F0A24B</Color>
    <Color x:Key="BadColor">#FF7A70</Color>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSoft" Color="#24F0A24B" />
    <SolidColorBrush x:Key="WarnEdge" Color="#59F0A24B" />
    <SolidColorBrush x:Key="Admin" Color="#6FB1FF" />
    <SolidColorBrush x:Key="AdminSoft" Color="#246FB1FF" />
    <SolidColorBrush x:Key="AdminEdge" Color="#596FB1FF" />
    <SolidColorBrush x:Key="Dup" Color="#B79CFF" />
    <SolidColorBrush x:Key="DupSoft" Color="#24B79CFF" />
    <SolidColorBrush x:Key="DupEdge" Color="#59B79CFF" />
    <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="BadSoft" Color="#24FF7A70" />
    <SolidColorBrush x:Key="BadEdge" Color="#59FF7A70" />

    <!-- Fluent'in sistem vurgusuna bağlı fırçaları (menü, kaydırma, seçim) aynı maviye çekilir. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Opacity="0.9" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Opacity="0.8" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#2F6FC4" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#08182D" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource AccentColor}" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Düğmeler: üzerine gelince/basınca yarı saydam katman; tüm türlerde aynı davranış. -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Overlay" CornerRadius="6" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="BtnIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Onay kutusu: 18 px kare, dikeyde ortalı. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- Dolgu ile çerçeve ayrı katman: aynı Border'da dolgu çerçevenin içine çizilir ve kenarda açık bir halka kalır. -->
                        <Grid Width="18" Height="18" UseLayoutRounding="True">
                            <Border x:Name="Fill" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="Outline" CornerRadius="4" BorderBrush="{DynamicResource Dim}" BorderThickness="1.5" />
                            <!-- Koordinatlar 18 px kutuya göre; işaret tam ortada. -->
                            <Path x:Name="Mark" Data="M 4.75,9.25 L 7.75,12.25 L 13.25,6" Stroke="{DynamicResource OnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <!-- Etiket yalnızca içerik verilince yer kaplar; tablodaki kutular ortalı kalır. -->
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Arama kutusu: simge, yer tutucu metin ve Ctrl+F ipucu. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Dim}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                            <Border Grid.Column="2" Margin="6,0,8,0" Padding="5,1" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource Line}" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl F" FontSize="11" Foreground="{DynamicResource Dim}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Çerçeveli tek satırlık giriş kutusu (pencerelerdeki metin alanları). -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Çerçevesiz, salt okunur metin alanı (ham günlük). -->
    <Style x:Key="PlainBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- İlerleme: 4 px ince şerit, yuvarlak uçlu vurgu dolgusu. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Güncelleme çubuğu: dolu kısım kırmızıdan yeşile; renk geçişi tüm iz boyunca sabit, dolgu ilerledikçe açılır. -->
    <ControlTemplate x:Key="HealthProgressTemplate" TargetType="ProgressBar">
        <Grid>
            <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                <Border HorizontalAlignment="Left" CornerRadius="2" Width="{Binding ActualWidth, ElementName=PART_Track}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="{StaticResource BadColor}" />
                            <GradientStop Offset="0.5" Color="{StaticResource WarnColor}" />
                            <GradientStop Offset="1" Color="{StaticResource OkColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Rozetler: renkli metin, aynı tonda saydam zemin ve çerçeve. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
